# Konfigurasi stack produksi. Buat .env dengan rahasia acak:  sh gen-env.sh   (lalu sunting alamat di bawah).
# .env TIDAK pernah di-commit dan dikecualikan dari konteks build Docker. Panduan: docs/DEPLOY.md.

# ---------------------------------------------------------------------------
# 1. ALAMAT AKSES -- pilih SATU mode
# ---------------------------------------------------------------------------
# Mode DOMAIN (disarankan; HTTPS otomatis lewat Let's Encrypt): dua nama host yang DNS-nya sudah mengarah ke
# server ini, dan port 80 + 443 terbuka di firewall.
STUDENT_ADDRESS=belajar.contoh.id
ADMIN_ADDRESS=admin.belajar.contoh.id
PUBLIC_STUDENT_URL=https://belajar.contoh.id
PUBLIC_ADMIN_URL=https://admin.belajar.contoh.id

# Mode UJI TANPA DOMAIN (HTTP biasa lewat IP -- JANGAN untuk pemakaian sungguhan: kata sandi lewat tanpa enkripsi).
# Ganti empat baris di atas dengan (isi IP-SERVER dengan IP publik server; buka port 80 dan 8080):
#   STUDENT_ADDRESS=:80
#   ADMIN_ADDRESS=:8080
#   PUBLIC_STUDENT_URL=http://IP-SERVER
#   PUBLIC_ADMIN_URL=http://IP-SERVER:8080

# Zona waktu "hari" (kuota tutor, streak, leaderboard mingguan)
TZ=Asia/Jakarta

# ---------------------------------------------------------------------------
# 2. RAHASIA -- dibuat otomatis oleh gen-env.sh. Pakai huruf/angka saja (masuk ke URL database).
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=GANTI
# Rahasia JWT murid dan admin SENGAJA berbeda (token murid bocor tidak boleh berlaku sebagai token admin).
JWT_STUDENT_SECRET=GANTI
JWT_ADMIN_SECRET=GANTI

# ---------------------------------------------------------------------------
# 3. PENYIMPANAN AUDIO -- DISK LOKAL (tahap uji coba; tanpa S3)
# ---------------------------------------------------------------------------
# Audio hasil TTS ditulis ke volume Docker `media_data` dan disajikan API di ${PUBLIC_STUDENT_URL}/media. Tidak ada
# yang perlu diisi. Ikut cadangan (backup.sh). Nanti, bila perlu S3/CDN: STORAGE_DRIVER=s3 + S3_* + alamat publik bucket
# (lihat docs/DEPLOY.md, bagian "Penyimpanan audio"):
#   STORAGE_DRIVER=s3
#   STORAGE_PUBLIC_BASE_URL=https://audio-assets.s3.ap-southeast-1.amazonaws.com
#   S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
#   S3_REGION=ap-southeast-1
#   S3_BUCKET=audio-assets
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=
STORAGE_DRIVER=local

# ---------------------------------------------------------------------------
# 4. OPSIONAL -- semuanya boleh dibiarkan kosong; fitur terkait saja yang nonaktif
# ---------------------------------------------------------------------------
# AI tutor (OpenAI). Kosong = endpoint /tutor menjawab 503, bagian lain tidak terpengaruh.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_DEFAULT=nova
TUTOR_DAILY_QUOTA=20
# Audio pelajaran (kosakata/kalimat, dibuat sekali lewat `db:seed`). Kosong = pelajaran berjalan tanpa audio.
# TTS_PROVIDER: auto (bawaan) = Azure bila AZURE_* di bawah terisi, kalau tidak OpenAI bila OPENAI_API_KEY di atas
# terisi | openai | azure | none. Belum punya kunci Azure? Cukup isi OPENAI_API_KEY (kunci yang sama dengan AI tutor).
# Dengarkan contoh suaranya dulu:  docker compose run --rm tools pnpm run tts:sample
TTS_PROVIDER=auto
# Suara OpenAI untuk audio pelajaran (kosong = bawaan nova / onyx); mengikuti OPENAI_TTS_MODEL di atas.
OPENAI_LESSON_TTS_VOICE_FEMALE=
OPENAI_LESSON_TTS_VOICE_MALE=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Email transaksional: BELUM ada pengirim email sungguhan (MailModule masih mencetak tautan ke log API) --
# lihat "Batasan" di docs/DEPLOY.md.
MAIL_FROM=noreply@contoh.id
MAIL_PROVIDER_API_KEY=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=14d
