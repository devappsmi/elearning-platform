# Salin berkas ini menjadi `.env` (di folder qa/) lalu isi. Berkas `.env` tidak masuk ke git.
# Variabel yang sudah diset di terminal lebih diutamakan daripada isi berkas ini.

# ---- Alamat (tanpa garis miring di akhir) -------------------------------------------------------------------------
# Lokal (pengembangan):   murid http://localhost:5173   admin http://localhost:5174   API http://localhost:3001
# Server uji/produksi:    isi dengan alamat sungguhan, misalnya https://belajar.contoh.id
QA_STUDENT_URL=http://localhost:5173
QA_ADMIN_URL=http://localhost:5174
# Alamat API dipakai skrip uji API (npm run test:api). Di server dengan Caddy biasanya <alamat murid>/api.
QA_API_URL=http://localhost:3001

# ---- Akun uji -----------------------------------------------------------------------------------------------------
# Murid uji: dibuat oleh tim teknis dengan  `pnpm --filter api run student:create`  (lihat qa/README.md bagian Akun uji).
QA_STUDENT_EMAIL=
QA_STUDENT_PASSWORD=
# Murid kedua (opsional): dipakai uji admin yang mengubah akun (pindah kelas, nonaktifkan, aktifkan).
QA_STUDENT2_EMAIL=
QA_STUDENT2_PASSWORD=
# Murid KHUSUS uji penguncian akun (opsional). Setelah uji, akun ini terkunci 15 menit. Kosongkan untuk melewati uji itu.
QA_LOCKOUT_EMAIL=
QA_LOCKOUT_PASSWORD=
# Admin uji: dibuat dengan  `pnpm --filter api run admin:create`.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# ---- Pilihan ------------------------------------------------------------------------------------------------------
# Pelajaran yang dimainkan uji belajar (l1 = pelajaran pertama Hiragana, selalu terbuka).
QA_LESSON_ID=l1
# Uji Ngobrol dengan AI: auto = dilewati bila AI belum diaktifkan di server | off = lewati | on = wajib aktif.
QA_AI=auto
# 1 = jalankan juga uji merekam suara (memakai mikrofon palsu Chromium; hasil pengenalan dengan AI sungguhan tidak bisa dipastikan).
QA_AI_SUARA=0
# Ambang waktu respons uji API (milidetik); lebih lambat dari ini dilaporkan sebagai gagal oleh npm run test:api.
QA_LATENCY_MS=1500
# Awalan nama data uji yang dibuat uji admin (kelas dan undangan), supaya mudah dikenali dan dibersihkan.
QA_PREFIX=QA
# Jumlah ulang otomatis bila uji gagal (0 = tanpa ulang, disarankan agar kegagalan tidak tersembunyi).
QA_RETRIES=0
# 1 = tampilkan jendela browser saat uji berjalan; QA_SLOW_MO = jeda per aksi dalam milidetik.
QA_TAMPILKAN_BROWSER=0
QA_SLOW_MO=0
