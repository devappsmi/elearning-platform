# Salin ke .env dan isi nilai sungguhan -- .env tidak pernah di-commit.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://elearning:elearning@localhost:5432/elearning
REDIS_URL=redis://localhost:6379

# JWT -- secret student dan admin SENGAJA BEDA (lihat plan poin 4: batas
# kepercayaan terpisah, token murid yang bocor tidak boleh bisa dipakai
# sebagai token admin).
JWT_STUDENT_SECRET=change-me-student-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=14d

# Email transaksional (undangan, reset password) -- provider belum
# diputuskan (SendGrid/Mailgun/SES), isi sesuai yang dipakai.
MAIL_FROM=noreply@example.com
MAIL_PROVIDER_API_KEY=

# S3-compatible storage (audio TTS cache) -- penyimpanan S3-kompatibel lokal via docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=audio-assets
S3_ACCESS_KEY_ID=elearning
S3_SECRET_ACCESS_KEY=elearning123
# Alamat PUBLIK objek (yang dibuka browser). Kosong = S3_ENDPOINT/S3_BUCKET -- cukup untuk dev lokal. Di Docker
# atau di belakang reverse proxy, endpoint S3 bersifat internal: isi dengan URL publiknya (lihat deploy/).
S3_PUBLIC_BASE_URL=

# OpenAI (TutorModule -- port dari server/ai_tutor lama)
# Nama model di bawah = bawaan dari catatan lama, BELUM terbukti ada. Cek dengan kunci sungguhan:
#   OPENAI_API_KEY=sk-... pnpm --filter api run test:live-openai
# (kalau nama ditolak, pesan gagalnya mencantumkan model yang tersedia untuk akunmu; lihat docs/PLAN.md bagian 6)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_DEFAULT=nova
# Kuota balasan AI tutor per murid per hari (default 20, versi lama hardcode 20)
TUTOR_DAILY_QUOTA=20

# TTS untuk konten (lesson/dictionary/scenario, bukan TutorModule) -- dipakai
# AudioModule (Milestone 8). Rekomendasi plan: Azure Cognitive Speech (satu
# vendor dengan Pronunciation Assessment Fase 2), belum final -- lihat
# docs/PLAN.md. Kosong = AudioService melempar error yang jelas SAAT resolusi
# audio dipanggil (bukan gagal boot) -- server/seed tetap jalan, audio jadi
# placeholder kosong sampai ini diisi.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE_FEMALE=ja-JP-NanamiNeural
AZURE_TTS_VOICE_MALE=ja-JP-KeitaNeural

CORS_ORIGIN_STUDENT=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174

# Jumlah proxy tepercaya di depan API (mis. 1 untuk satu load balancer/Nginx). WAJIB diisi di
# produksi yang memakai reverse proxy: tanpa ini semua klien tampak berasal dari IP proxy, sehingga
# pembatas per-IP (login, /auth/forgot, permintaan undangan ulang) menjadi SATU jatah untuk seluruh
# pengguna. JANGAN "true" (mempercayai semua header X-Forwarded-For, bisa dipalsukan klien). Kosong
# atau 0 = tanpa proxy (dev lokal). Lihat src/common/trust-proxy.ts.
TRUST_PROXY=
